generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String?
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookmarks    Bookmark[]
  watchHistory WatchHistory[]
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  title       String
  posterPath  String?
  releaseDate String?
  voteAverage Float?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      Int
  title       String
  posterPath  String?
  releaseDate String?
  voteAverage Float?
  watchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}
